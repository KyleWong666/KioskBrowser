<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KioskBrowser</AssemblyName>
    <RootNamespace>KioskBrowser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <ProjectReference Include="..\KioskBrowser.Shared\KioskBrowser.Shared.csproj" />
    <ProjectReference Include="..\KioskBrowser.Abstractions\KioskBrowser.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\pinyin_dict.txt" />
    <EmbeddedResource Include="Resources\pinyin_phrases.txt" />
    <EmbeddedResource Include="Resources\pinyin_initials.txt" />
    <EmbeddedResource Include="Resources\pinyin_primary.txt" />
    <EmbeddedResource Include="Resources\vocab_gov.txt" />
    <EmbeddedResource Include="Resources\vocab_medical.txt" />
    <EmbeddedResource Include="Resources\vocab_retail.txt" />
    <EmbeddedResource Include="Resources\vocab_industrial.txt" />
  </ItemGroup>

</Project>
